{%- comment -%}
  "También te puede interesar": un único producto tomado de la misma
  colección que el primer producto del carrito (fitness/bienestar),
  nunca aleatorio. Se omite si no hay una colección real de referencia
  o si no queda ningún producto distinto de los que ya están en el carrito.
{%- endcomment -%}
{%- liquid
  assign suggested_product = blank

  if cart.item_count > 0
    assign reference_product = cart.items.first.product
    assign source_collection = reference_product.collections.first

    if source_collection != blank
      for candidate in source_collection.products
        assign already_in_cart = false
        for item in cart.items
          if item.product_id == candidate.id
            assign already_in_cart = true
          endif
        endfor
        if already_in_cart == false and suggested_product == blank
          assign suggested_product = candidate
        endif
      endfor
    endif
  endif
-%}

{%- if suggested_product != blank -%}
  {%- assign suggested_variant = suggested_product.selected_or_first_available_variant -%}
  <div class="cart-suggestion">
    <p class="cart-suggestion__label">También te puede interesar</p>
    <div class="cart-suggestion__card">
      <a href="{{ suggested_product.url }}" class="cart-suggestion__media">
        {{ suggested_product.featured_image | image_url: width: 160 | image_tag:
          loading: 'lazy',
          alt: suggested_product.featured_image.alt | default: suggested_product.title,
          class: 'cart-suggestion__image'
        }}
      </a>
      <div class="cart-suggestion__info">
        <a href="{{ suggested_product.url }}" class="cart-suggestion__title">{{ suggested_product.title }}</a>
        <p class="cart-suggestion__price">{{ suggested_variant.price | money }}</p>
      </div>
      <button
        type="button"
        class="cart-suggestion__add"
        data-cart-suggestion-add
        data-variant-id="{{ suggested_variant.id }}"
        {% unless suggested_variant.available %}disabled{% endunless %}
      >
        {%- if suggested_variant.available -%}Añadir{%- else -%}Agotado{%- endif -%}
      </button>
    </div>
  </div>
{%- endif -%}
