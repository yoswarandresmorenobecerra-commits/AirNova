{%- comment -%}
  Barra de progreso de envío gratis. Se calcula 100% sobre cart.total_price
  (subtotal real del carrito). Si no hay umbral configurado (0 o vacío),
  no se renderiza nada — nunca se muestra una barra sin una meta real detrás.
{%- endcomment -%}
{%- liquid
  assign threshold = settings.free_shipping_threshold
-%}
{%- if threshold > 0 -%}
  {%- assign threshold_cents = threshold | times: 100 -%}

  {%- if cart.total_price >= threshold_cents -%}
    <div class="cart-shipping-bar cart-shipping-bar--unlocked" data-cart-shipping-bar>
      <p class="cart-shipping-bar__text">
        {% render 'icon', name: 'shipping' %}
        <span>Tu pedido tiene envío gratis</span>
      </p>
      <div class="cart-shipping-bar__track">
        <div class="cart-shipping-bar__fill" style="width: 100%"></div>
      </div>
    </div>
  {%- else -%}
    {%- assign remaining_cents = threshold_cents | minus: cart.total_price -%}
    {%- assign progress_percent = cart.total_price | times: 100 | divided_by: threshold_cents -%}
    <div class="cart-shipping-bar" data-cart-shipping-bar>
      <p class="cart-shipping-bar__text">
        Te faltan <strong>{{ remaining_cents | money }}</strong> para el envío gratis
      </p>
      <div class="cart-shipping-bar__track">
        <div class="cart-shipping-bar__fill" style="width: {{ progress_percent }}%"></div>
      </div>
    </div>
  {%- endif -%}
{%- endif -%}
