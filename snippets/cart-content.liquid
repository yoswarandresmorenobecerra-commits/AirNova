{%- comment -%}
  Cuerpo del carrito, compartido por el drawer (sections/cart-drawer.liquid)
  y la página de carrito (sections/main-cart.liquid).
{%- endcomment -%}

{% render 'cart-free-shipping-bar' %}

{%- if cart.item_count > 0 -%}
  <ul class="cart-items">
    {%- for item in cart.items -%}
      <li class="cart-item">
        <a href="{{ item.url }}" class="cart-item__media">
          {{ item.image | image_url: width: 200 | image_tag:
            loading: 'lazy',
            alt: item.image.alt | default: item.product.title,
            class: 'cart-item__image'
          }}
        </a>

        <div class="cart-item__details">
          <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
          {%- unless item.variant.title == 'Default Title' -%}
            <p class="cart-item__variant">{{ item.variant.title }}</p>
          {%- endunless -%}
          <p class="cart-item__price">{{ item.final_price | money }}</p>

          <div class="cart-item__qty">
            <button
              type="button"
              class="cart-item__qty-btn"
              data-cart-qty-decrease
              data-line="{{ forloop.index }}"
              aria-label="Reducir cantidad"
            >−</button>
            <input
              type="number"
              class="cart-item__qty-input"
              data-cart-qty-input
              data-line="{{ forloop.index }}"
              value="{{ item.quantity }}"
              min="0"
              aria-label="Cantidad"
            >
            <button
              type="button"
              class="cart-item__qty-btn"
              data-cart-qty-increase
              data-line="{{ forloop.index }}"
              aria-label="Aumentar cantidad"
            >+</button>
          </div>
        </div>

        <button
          type="button"
          class="cart-item__remove"
          data-cart-remove
          data-line="{{ forloop.index }}"
          aria-label="Quitar {{ item.product.title }}"
        >
          {% render 'icon', name: 'close' %}
        </button>
      </li>
    {%- endfor -%}
  </ul>

  <div class="cart-subtotal">
    <span>Subtotal</span>
    <span class="cart-subtotal__price">{{ cart.total_price | money }}</span>
  </div>

  {% render 'cart-suggested-product' %}

  {% render 'cart-guarantees' %}

  <a href="{{ routes.cart_checkout_url }}" class="btn btn--primary btn--full cart-checkout-button" data-cart-checkout>
    Finalizar compra
  </a>
{%- else -%}
  <div class="cart-empty">
    <p class="cart-empty__text">Tu carrito está vacío.</p>
    <a href="{{ routes.all_products_collection_url }}" class="btn btn--secondary btn--full">Seguir comprando</a>
  </div>
{%- endif -%}
