{%- if section.blocks.size > 0 -%}
  <section class="product-faq">
    {%- if section.settings.heading != blank -%}
      <h2 class="product-faq__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="product-faq__list">
      {%- for block in section.blocks -%}
        <details class="product-faq__item" {{ block.shopify_attributes }}>
          <summary class="product-faq__question">
            {{ block.settings.question }}
            <span class="product-faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="product-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% style %}
  .product-faq {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1.25rem;
  }

  .product-faq__heading {
    text-align: center;
    color: var(--color-text);
    margin: 0 0 1.25rem;
    font-size: 1.4rem;
  }

  .product-faq__list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .product-faq__item {
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 0.9rem 1.1rem;
    background: var(--color-surface);
  }

  .product-faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    color: var(--color-text);
    font-size: 0.95rem;
  }

  .product-faq__question::-webkit-details-marker {
    display: none;
  }

  .product-faq__icon {
    flex-shrink: 0;
    width: 0.6rem;
    height: 0.6rem;
    border-right: 2px solid var(--color-primary);
    border-bottom: 2px solid var(--color-primary);
    transform: rotate(45deg);
    transition: transform 0.15s ease;
  }

  .product-faq__item[open] .product-faq__icon {
    transform: rotate(-135deg);
  }

  .product-faq__answer {
    margin-top: 0.75rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.55;
  }
{% endstyle %}

{% schema %}
{
  "name": "Preguntas frecuentes",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Preguntas frecuentes"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Pregunta",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pregunta"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Respuesta"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Preguntas frecuentes",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "¿Cómo sé qué talla elegir?",
            "answer": "[PENDIENTE: agregar guía de tallas real de este producto]"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "¿Cómo se ajusta al cuerpo?",
            "answer": "[PENDIENTE: describir el ajuste real de este producto]"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "¿Cómo cuido el material?",
            "answer": "[PENDIENTE: agregar instrucciones reales de cuidado de este material]"
          }
        }
      ]
    }
  ]
}
{% endschema %}
