<section class="trust-bar">
  <ul class="trust-bar__list">
    {%- for block in section.blocks -%}
      <li class="trust-bar__item" {{ block.shopify_attributes }}>
        <span class="trust-bar__icon">
          {% render 'icon', name: block.settings.icon %}
        </span>
        <span class="trust-bar__text">{{ block.settings.text }}</span>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% style %}
  .trust-bar {
    background: var(--color-background);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 1rem 0.75rem;
  }

  .trust-bar__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem 0.5rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .trust-bar__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.35rem;
    color: var(--color-text);
  }

  .trust-bar__icon {
    color: var(--color-primary);
  }

  .trust-bar__text {
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.3;
  }

  @media (min-width: 750px) {
    .trust-bar__list {
      grid-template-columns: repeat(var(--trust-bar-columns, 4), 1fr);
      gap: 1.5rem;
    }

    .trust-bar__item {
      flex-direction: row;
      text-align: left;
    }

    .trust-bar__text {
      font-size: 0.9rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Barra de confianza",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Elemento",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "shipping", "label": "Envío" },
            { "value": "cod", "label": "Pago contraentrega" },
            { "value": "guarantee", "label": "Garantía" },
            { "value": "returns", "label": "Devoluciones" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Envío a toda Colombia"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Barra de confianza",
      "blocks": [
        { "type": "item", "settings": { "icon": "shipping", "text": "Envío a toda Colombia" } },
        { "type": "item", "settings": { "icon": "cod", "text": "Pago contraentrega" } },
        { "type": "item", "settings": { "icon": "guarantee", "text": "Garantía de 30 días" } }
      ]
    }
  ]
}
{% endschema %}
