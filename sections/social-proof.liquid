{%- comment -%}
  Esta sección solo se muestra si el comerciante ha cargado testimonios
  reales como bloques. Sin bloques, no se renderiza nada — nunca se
  inventan reseñas ni cifras de clientes.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <section class="social-proof">
    {%- if section.settings.heading != blank -%}
      <h2 class="social-proof__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <ul class="social-proof__list">
      {%- for block in section.blocks -%}
        <li class="social-proof__item" {{ block.shopify_attributes }}>
          <p class="social-proof__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
          <p class="social-proof__author">
            {{ block.settings.author_name }}
            {%- if block.settings.author_detail != blank -%}
              <span class="social-proof__author-detail">— {{ block.settings.author_detail }}</span>
            {%- endif -%}
          </p>
        </li>
      {%- endfor -%}
    </ul>
  </section>
{%- endif -%}

{% style %}
  .social-proof {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.25rem;
    background: var(--color-surface);
    border-radius: 12px;
  }

  .social-proof__heading {
    text-align: center;
    color: var(--color-text);
    margin: 0 0 1.5rem;
    font-size: 1.4rem;
  }

  .social-proof__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .social-proof__item {
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.1rem;
  }

  .social-proof__quote {
    margin: 0 0 0.6rem;
    color: var(--color-text);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .social-proof__author {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .social-proof__author-detail {
    font-weight: 400;
  }

  @media (min-width: 750px) {
    .social-proof__list {
      flex-direction: row;
    }

    .social-proof__item {
      flex: 1;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Prueba social",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Lo que dicen nuestros clientes"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonio",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Testimonio real del cliente"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Nombre del cliente"
        },
        {
          "type": "text",
          "id": "author_detail",
          "label": "Detalle (ciudad, producto comprado, etc.)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Prueba social",
      "blocks": []
    }
  ]
}
{% endschema %}
