<section class="hero">
  {%- if section.settings.image != blank -%}
    <div class="hero__media">
      {{ section.settings.image | image_url: width: 1600 | image_tag:
        loading: 'lazy',
        widths: '400,600,800,1200,1600',
        sizes: '100vw',
        alt: section.settings.image.alt | default: section.settings.heading,
        class: 'hero__image'
      }}
    </div>
  {%- endif -%}

  <div class="hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h1 class="hero__heading">{{ section.settings.heading }}</h1>

    {%- if section.settings.subheading != blank -%}
      <p class="hero__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--primary btn--full hero__cta">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% style %}
  .hero {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
  }

  .hero__media {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface-alt);
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero__content {
    padding: 1.75rem 1.25rem 2.25rem;
    text-align: center;
  }

  .hero__eyebrow {
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
  }

  .hero__heading {
    margin: 0 0 0.75rem;
    font-size: 1.75rem;
    line-height: 1.2;
    color: var(--color-text);
  }

  .hero__subheading {
    margin: 0 0 1.5rem;
    color: var(--color-text-secondary);
    font-size: 1rem;
    line-height: 1.5;
  }

  .hero__cta {
    max-width: 420px;
    margin: 0 auto;
  }

  @media (min-width: 750px) {
    .hero {
      flex-direction: row-reverse;
      align-items: center;
    }

    .hero__media,
    .hero__content {
      width: 50%;
    }

    .hero__media {
      aspect-ratio: 4 / 5;
    }

    .hero__content {
      text-align: left;
      padding: 3rem 4rem;
    }

    .hero__heading {
      font-size: 2.75rem;
    }

    .hero__cta {
      margin: 0;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior (opcional)",
      "default": "Postura · Movilidad · Recuperación"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Propuesta de valor",
      "default": "Alivia el dolor de espalda y recupera tu movilidad, 15 minutos al día"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Herramientas de recuperación y corrección postural diseñadas para quienes pasan el día sentados o entrenando."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón de acción",
      "default": "Comprar ahora"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
