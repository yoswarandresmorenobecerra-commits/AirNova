<section class="why-buy">
  {%- if section.settings.heading != blank -%}
    <h2 class="why-buy__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <ul class="why-buy__list">
    {%- for block in section.blocks -%}
      <li class="why-buy__item" {{ block.shopify_attributes }}>
        <span class="why-buy__icon">
          {% render 'icon', name: block.settings.icon %}
        </span>
        <div class="why-buy__copy">
          <h3 class="why-buy__item-title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="why-buy__item-text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% style %}
  .why-buy {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.25rem;
  }

  .why-buy__heading {
    text-align: center;
    color: var(--color-text);
    margin: 0 0 1.5rem;
    font-size: 1.4rem;
  }

  .why-buy__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .why-buy__item {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
  }

  .why-buy__icon {
    flex-shrink: 0;
    color: var(--color-primary);
  }

  .why-buy__item-title {
    margin: 0 0 0.2rem;
    font-size: 1rem;
    color: var(--color-text);
  }

  .why-buy__item-text {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.45;
  }

  @media (min-width: 750px) {
    .why-buy__list {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 2rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Por qué comprar",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "¿Por qué comprar en AirNovaFit?"
    }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Razón",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "shipping", "label": "Envío / despacho" },
            { "value": "guarantee", "label": "Garantía" },
            { "value": "cod", "label": "Pago contraentrega" },
            { "value": "chat", "label": "Soporte / chat" },
            { "value": "returns", "label": "Devoluciones" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Despacho rápido"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Descripción",
          "default": "Procesamos y enviamos tu pedido en 24-48h."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Por qué comprar",
      "blocks": [
        {
          "type": "reason",
          "settings": {
            "icon": "shipping",
            "title": "Despacho rápido",
            "text": "Procesamos y enviamos tu pedido en 24-48h."
          }
        },
        {
          "type": "reason",
          "settings": {
            "icon": "guarantee",
            "title": "Garantía de 30 días",
            "text": "Si el producto tiene un defecto de fábrica, te lo cambiamos o devolvemos tu dinero."
          }
        },
        {
          "type": "reason",
          "settings": {
            "icon": "cod",
            "title": "Pago contraentrega",
            "text": "Paga cuando recibas tu pedido en la puerta de tu casa, sin riesgo."
          }
        },
        {
          "type": "reason",
          "settings": {
            "icon": "chat",
            "title": "Soporte por WhatsApp",
            "text": "Resolvemos tus dudas antes y después de la compra, directo con nuestro equipo."
          }
        }
      ]
    }
  ]
}
{% endschema %}
